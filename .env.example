# Copy to .env and fill in (or set these as GitHub repo secrets for the scheduled run).
# Run locally with:  node --env-file=.env  (or `npm start` after exporting them).
# Everything except the Supabase + tracker vars is optional — unset channels are skipped.

# Supabase (same project as the tracker). SERVICE ROLE key — server-only, NEVER commit/expose.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Your tracker account's user id (Supabase dashboard -> Authentication -> Users -> copy the UUID).
TRACKER_USER_ID=

# Telegram (fast alerts): create a bot via @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OUTBOUND alert email via Resend (https://resend.com). Optional — this is how the
# monitor mails YOU. (Not to be confused with the inbound alert inbox below.)
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=onboarding@resend.dev

# --- INBOUND job-alert inbox (the `emailalerts` source) ---
# Handshake, LinkedIn, ZipRecruiter, Glassdoor and part of Indeed cannot be polled
# (school SSO / Cloudflare / rate limits), but every one of them will EMAIL its
# matches if you save a search with alerts turned on. The monitor reads those
# emails over IMAP, READ-ONLY — nothing is marked as read and no flag is touched.
# Use a DEDICATED inbox (e.g. yourname+jobalerts@gmail.com), never your main one.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it here WITHOUT the spaces.
# Unset = "[fetch] Email alerts: skipped (no inbox configured)" and zero rows.
ALERT_INBOX_USER=
ALERT_INBOX_APP_PASSWORD=
# Optional; the values below are the defaults.
# ALERT_INBOX_HOST=imap.gmail.com
# ALERT_INBOX_PORT=993
# ALERT_INBOX_MAILBOX=INBOX
# ALERT_INBOX_DAYS=3
# ALERT_INBOX_MAX_MESSAGES=200
# ALERT_INBOX_BUDGET_SEC=90
# Where `npm run alerts -- --dump` writes messages that yielded no job links:
# ALERT_DUMP_DIR=

# --- Optional behavior tuning ---
# Don't alert/add roles whose JD rules out F-1 sponsorship (still recorded as seen):
# SKIP_NO_SPONSORSHIP=true
# Only alert roles posted within N days (reduces stale-repost noise):
# MAX_AGE_DAYS=14

# --- Daily apply queue (npm run digest / daily-digest.yml) ---
# How many roles the 08:00 ET checklist holds:
# DIGEST_SIZE=5
# Drop candidates older than N days from the queue:
# DIGEST_MAX_AGE_DAYS=10
# How far back the candidate pool is read (wider than the age limit on purpose):
# DIGEST_POOL_DAYS=30
